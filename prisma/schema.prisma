// Duo Gym App — data model
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ScoreEventType {
  STREAK_BONUS
  MILESTONE_BONUS
  MISSED_PENALTY
  BUDDY_PENALTY
}

enum NotificationType {
  GYM_DAY
  LOG_REMINDER
}

/// An account: credentials, profile, and the running score/streak totals.
model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
  displayName  String
  timezone     String @default("America/New_York")
  avatarColor  String @default("#7C5CFC")

  gymScore          Int       @default(0)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastEvaluatedDate DateTime? // watermark: missed-day evaluation has run through this date

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleDays ScheduleDay[]
  workoutLogs  WorkoutLog[]
  scoreEvents  ScoreEvent[]
  lateLogs     LateLog[]
  pairingCode  PairingCode?

  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  notificationDeliveries NotificationDelivery[]

  pairAsUserA BuddyPair? @relation("PairA")
  pairAsUserB BuddyPair? @relation("PairB")
}

/// A confirmed 1:1 accountability pairing between two users.
model BuddyPair {
  id        String   @id @default(cuid())
  userAId   String   @unique
  userBId   String   @unique
  createdAt DateTime @default(now())

  userA User @relation("PairA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("PairB", fields: [userBId], references: [id], onDelete: Cascade)
}

/// A short-lived, one-time code a user shares to let someone else pair with them.
model PairingCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A user's recurring plan for one weekday: whether it's a gym day and its exercises.
model ScheduleDay {
  id       String  @id @default(cuid())
  userId   String
  weekday  Weekday
  isGymDay Boolean @default(true)
  label    String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  workoutLogs WorkoutLog[]

  @@unique([userId, weekday])
}

/// A single exercise within a schedule day, with its target sets/reps.
model Exercise {
  id            String  @id @default(cuid())
  scheduleDayId String
  name          String
  order         Int     @default(0)
  targetSets    Int     @default(3)
  targetReps    Int     @default(10)
  notes         String?

  scheduleDay ScheduleDay @relation(fields: [scheduleDayId], references: [id], onDelete: Cascade)
  setLogs     SetLog[]
}

/// One user's completed (or in-progress) workout for a single calendar day.
model WorkoutLog {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime // date-only, midnight UTC representing the user's local calendar day
  scheduleDayId String?
  completed     Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleDay ScheduleDay? @relation(fields: [scheduleDayId], references: [id])
  setLogs     SetLog[]

  @@unique([userId, date])
}

/// A single logged set (weight × reps) for one exercise within a workout log.
model SetLog {
  id           String   @id @default(cuid())
  workoutLogId String
  exerciseId   String
  setNumber    Int
  weight       Float
  reps         Int
  createdAt    DateTime @default(now())

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

/// An audit-log entry for a single point change (bonus or penalty) applied to a user.
model ScoreEvent {
  id        String         @id @default(cuid())
  userId    String
  date      DateTime
  type      ScoreEventType
  points    Int
  reason    String
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

/// One use of the weekly "forgot to log" allowance: a workout logged for yesterday
/// after the day ended. Kept separate from WorkoutLog so deleting the log doesn't
/// refund the use, and re-saving the same day never charges twice.
model LateLog {
  id         String   @id @default(cuid())
  userId     String
  targetDate DateTime // the forgotten day, date-only midnight UTC
  weekStart  DateTime // Monday of the week the allowance was used in, date-only midnight UTC
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetDate])
  @@index([userId, weekStart])
}

/// Which reminders a user wants and when, as minutes after local midnight in their
/// timezone. No row means the defaults in NOTIFICATIONS (lib/notifications.ts).
model NotificationPreference {
  userId             String   @id
  gymDayEnabled      Boolean  @default(true)
  gymDayMinute       Int      @default(480) // 08:00
  logReminderEnabled Boolean  @default(true)
  logReminderMinute  Int      @default(1200) // 20:00
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One browser/device that agreed to receive Web Push for a user. `endpoint` is the
/// push-service URL the browser handed out; `p256dh`/`auth` encrypt the payload.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A reminder already sent: at most one per user, type and local day. The unique
/// key is what makes the cron sweep idempotent and safe to run concurrently.
model NotificationDelivery {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  date      DateTime // the user's local day, date-only midnight UTC
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, date])
  @@index([createdAt])
}
