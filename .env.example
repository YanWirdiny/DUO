# Postgres connection string (Railway injects this automatically in production)
DATABASE_URL="postgresql://user:password@localhost:5432/duogym"

# Long random string used to sign auth session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Seed accounts (only used by `npm run db:seed`, never read at runtime)
SEED_USER1_USERNAME="you"
SEED_USER1_PASSWORD="change-me"
SEED_USER1_NAME="You"

SEED_USER2_USERNAME="buddy"
SEED_USER2_PASSWORD="change-me"
SEED_USER2_NAME="Buddy"

# Push notifications (optional; leave unset to keep the feature off).
# Generate a VAPID key pair once with:  npx web-push generate-vapid-keys
# The public key is sent to browsers; the private key must stay secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services: mailto:you@example.com or an https:// URL
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for POST /api/cron/notifications (min 32 chars). Generate like JWT_SECRET.
CRON_SECRET=""
# Only for the cron service (scripts/notify-cron.mjs): the app's public https URL
APP_URL="https://your-app.up.railway.app"
